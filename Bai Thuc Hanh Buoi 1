using System;
using System.Collections.Generic;
using System.Text;

namespace ExampleCAdvance.Hinh
{
    public interface IHinh
    {
        void Print();

        double getDienTich();

        double getChuVi();

        void nhapThongTin();
    }
}

public class HinhTron : Hinh
{
    public double BanKinh {get; set; }

    public HinhTron(double BanKinh)
    {
        if (banKinh <= 0)
        {
            throw new ArgumentException("Ban kinh phai lon hon 0.");
        }   
        BanKinh = banKinh;
    }

    public double TinhDienTich()
    {
        return Math.PI * BanKinh * BanKinh;
    }

    public double TinhChuVi()
    {
        return 2 * Math.PI * BanKinh;
    }
}

public class HinhChuNhat : Hinh
{
    private double dai;

    public double ChieuRong{ get; set; }
    [Range(0, double.Maxvalue, ErrorMessage = "Chieu rong phai lon hon hoac bang 0")]
    
    public double ChieuDai
    {
        get{ return dai; }
        set
        {if (dai < 0)
            dai = value;
            else
            throw new Exception("Chieu dai khong duoc am")
        }
    }

    public double getDienTich()
    {
        try
        {
            return this.ChieuDai*ChieuRong;
        }
        catch (Exception ex)
        {
            throw new Ex
        }
    }
}
